{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run on Target",
            "type": "shell",
            "command": "ssh TankBot -x TankBot/build/TankBot",
            "group": "none"
        },
        {
            "label": "Build on Target",
            "type": "shell",
            "command": "./build_remote",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}",
                "saveAll": "true"      // <-- This forces VS Code to save all editors
            }
        }
    ]
}